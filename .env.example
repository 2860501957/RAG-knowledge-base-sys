LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE=auto
CHROMA_DIR=storage/chroma
LOCAL_VECTOR_PATH=storage/local_vectors.json
UPLOAD_DIR=data/uploads
EVAL_OUTPUT_DIR=storage/eval_results
CHAT_LOG_PATH=storage/chat_logs.jsonl
MEMORY_PATH=storage/user_memory.json
MEMORY_ENABLED=true
MEMORY_MAX_RECENT_QUESTIONS=5
RUNTIME_LOG_PATH=storage/agent_runs.jsonl
RUNTIME_STEP_TIMEOUT_MS=0
RUNTIME_LLM_MAX_RETRIES=1
TOP_K=1
CHUNK_SIZE=180
CHUNK_OVERLAP=30
MIN_RETRIEVAL_SCORE=0.20
ANSWER_SUPPORT_CHECK_ENABLED=true
RERANK_ENABLED=false
RERANK_CANDIDATE_MULTIPLIER=3
RERANK_KEEP_K=1
EVAL_JUDGE_ENABLED=false
EVAL_JUDGE_MAX_CONTEXT_CHARS=3000
